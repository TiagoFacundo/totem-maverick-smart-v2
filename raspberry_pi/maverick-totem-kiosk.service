[Unit]
Description=Maverick Smart Totem - Aplicativo local em tela cheia
After=graphical-session.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=maverick
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/maverick/.Xauthority
WorkingDirectory=/opt/maverick-totem
ExecStart=/usr/bin/chromium --app=http://127.0.0.1:3000/ --kiosk --start-fullscreen --noerrdialogs --disable-infobars --disable-session-crashed-bubble --disable-translate --disable-features=Translate,MediaRouter --check-for-update-interval=31536000
Restart=always
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=graphical.target
