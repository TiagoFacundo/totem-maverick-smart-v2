# Porta publicada no Raspberry Pi
TOTEM_HTTP_PORT=3000

# Identidade do Totem
TOTEM_ID=TOTEM_001
TAP_ID=TORNEIRA_01

# Em produção, use HTTPS por proxy reverso e defina este token forte.
TOTEM_API_TOKEN=

# A composição padrão usa rede interna Docker para testes locais.
# Mantenha true somente em rede local isolada; não exponha a porta diretamente à internet.
ALLOW_INSECURE_LOCAL_API=true
DISABLE_OAUTH=true
MAVERICK_SERVER_URL=http://totem-app:3000

# GPIO BCM
SOLENOID_GPIO=17
FLOW_SENSOR_GPIO=27
RELAY_ACTIVE_HIGH=true
FLOW_PULSES_PER_LITER=450
FLOW_THRESHOLD_PULSES_PER_SEC=0.5
NO_FLOW_START_SECONDS=10
FLOW_STOP_SECONDS=5
COMMAND_POLL_SECONDS=0.5
MAX_POUR_SECONDS=90
MAX_POLL_FAILURES=3
PENDING_FINISH_FILE=/var/lib/maverick-tap/pending_finished.json

# Deve permanecer false depois do teste de bancada
MAVERICK_TEST_MODE=false
TEST_PULSES_PER_SEC=0
LOG_LEVEL=INFO

# Obtenha no Raspberry Pi com: getent group gpio | cut -d: -f3
GPIO_GID=997
