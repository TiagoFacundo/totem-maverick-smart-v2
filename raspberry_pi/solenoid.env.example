# URL HTTPS do servidor que expõe /api/public/tap
MAVERICK_SERVER_URL=https://maverickgrowch.com.br
TOTEM_ID=TOTEM_001
TAP_ID=TORNEIRA_01

# Use numeração BCM. Ajuste depois de testar com o relé desconectado da solenoide.
SOLENOID_GPIO=17
FLOW_SENSOR_GPIO=27
# Padrão para módulos comuns ativos em nível baixo; confirme no teste sem carga.
RELAY_ACTIVE_HIGH=false
FLOW_PULSES_PER_LITER=450
FLOW_THRESHOLD_PULSES_PER_SEC=0.5
NO_FLOW_START_SECONDS=10
FLOW_STOP_SECONDS=5
COMMAND_POLL_SECONDS=0.5
MAX_POUR_SECONDS=90
MAX_POLL_FAILURES=3
PENDING_FINISH_FILE=/var/lib/maverick-tap/pending_finished.json
